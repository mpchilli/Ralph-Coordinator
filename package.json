{
  "name": "ralph-orchestrator",
  "version": "2.3.0",
  "private": true,
  "description": "AI agent orchestrator with web dashboard",
  "main": "electron/main.js",
  "workspaces": [
    "backend/*",
    "frontend/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:server": "npm run build -w @ralph-web/server",
    "build:web": "npm run build -w @ralph-web/dashboard",
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev -w @ralph-web/server",
    "dev:web": "npm run dev -w @ralph-web/dashboard",
    "dev:app": "concurrently -k -n \"SERVER,WEB,APP\" -c \"blue,green,magenta\" \"npm run start:server\" \"npm run dev:web\" \"wait-on http://localhost:5173 && npm run electron:dev\"",
    "electron:dev": "electron .",
    "start": "npm run dev:app",
    "start:server": "npm run start -w @ralph-web/server",
    "test": "npm run test --workspaces --if-present",
    "test:server": "npm run test -w @ralph-web/server",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "orchestrator",
    "ralph"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^40.2.1",
    "wait-on": "^9.0.3"
  }
}